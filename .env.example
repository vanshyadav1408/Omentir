# Self-hosted mode
RUN_LOCALLY=TRUE
APP_BASE_URL=http://localhost:3000
# Required unless LOCAL_ALLOW_OPEN_ACCESS=true (explicit opt-in for a welcome button).
LOCAL_APP_PASSWORD=
# LOCAL_ALLOW_OPEN_ACCESS=true
# Required. Generate a unique value before startup; blank values fail validation.
LOCAL_SESSION_SECRET=
LOCAL_USER_NAME=Local User
LOCAL_USER_EMAIL=local@localhost

# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_KEY=

# Unipile
UNIPILE_DSN=
UNIPILE_API_KEY=
UNIPILE_WEBHOOK_SECRET=

# Gemini. Use this simple API-key path, or remove it and configure Vertex below.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
# Model for search-grounded calls (website analysis fallback, onboarding lead
# preview). Defaults to gemini-3.7-flash rather than GEMINI_MODEL, because older
# flash models time out on grounded calls instead of answering.
# GEMINI_SEARCH_MODEL=gemini-3.7-flash
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global
# GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Automation starts in dry-run unless this is explicitly true.
CRON_SECRET=
ENABLE_LIVE_AUTOMATION=false
# AUTOMATION_DISABLED=true

# Optional transactional notifications (self-host: your Resend account)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Your App <notifications@example.com>

# Extra origins allowed to reach the Next dev server for HMR / dev resources.
# localhost and 127.0.0.1 are always allowed. Add this only if you run `next dev`
# behind a proxy or tunnel and open the app on that hostname — otherwise Next
# blocks the HMR socket and the app never hydrates (buttons stop responding).
# Comma-separated, hostname only (no scheme). Example:
# ALLOWED_DEV_ORIGINS=dev.example.com,my-tunnel.example.net

# Hosted free tools (omentir.com /tools). Leave unset to disable the public lead finder and LinkedIn URL lookup.
# EXA_API_KEY=

# Sanity CMS for hosted marketing SEO content (features, blogs, comparisons,
# help, alternatives, integrations, legal, use cases, guides). These pages
# require Sanity configuration and return 404 when the CMS is unavailable.
# After you create the project at https://www.sanity.io/manage:
#   1. Add http://localhost:3000, https://omentir.com, and
#      https://sanity.omentir.com to CORS origins (allow credentials)
#      and to the Studio host list.
#   2. Create a Viewer token (SANITY_API_READ_TOKEN).
#   3. Webhook POST https://omentir.com/api/webhooks/sanity with the shared
#      secret, triggering on create/update/delete for the dataset.
#   4. Point sanity.omentir.com at the same VPS as omentir.com (CNAME or A
#      record) and issue TLS for that host. Studio is only at that host.
#      Do not rewrite the Host header to omentir.com. If the origin must
#      use that Host, send x-forwarded-host: sanity.omentir.com or
#      x-omentir-studio: 1 so / still opens Studio.
# NEXT_PUBLIC_SANITY_PROJECT_ID=
# NEXT_PUBLIC_SANITY_DATASET=production
# NEXT_PUBLIC_SANITY_API_VERSION=2026-08-30
# Viewer token for published reads. Required when the dataset is private.
# SANITY_API_READ_TOKEN=
# Shared secret for POST /api/webhooks/sanity cache revalidation.
# SANITY_REVALIDATE_SECRET=

# Hosted cloud only (omentir.com). Defaults match production brand identity.
# Self-host never needs these — leave unset.
# HOSTED_SUPPORT_EMAIL=hi@omentir.com
# HOSTED_CONTACT_EMAIL=vansh@omentir.com
# HOSTED_CONTACT_FORM_TO=vansh@omentir.com
# HOSTED_NEW_SIGNUP_TO=notifications@omentir.com
